# ===========================================
# 🔐 API KEYS (민감정보 — 실제 값은 .env에만)
# ===========================================

# Hugging Face API Token (Gemma 호출 및 모델 다운로드)
HF_TOKEN=


# ===========================================
# ⚙️ SERVER / BACKEND CONFIG
# ===========================================

# FastAPI 또는 Node.js 서버 포트
PORT=8000

# CORS 허용 도메인 (프론트엔드)
CORS_ORIGINS=http://localhost:3000


# ===========================================
# 📁 DIRECTORY PATHS
# (프로젝트 루트 기준, main.py / utils/env.py에서 사용)
# ===========================================

BASE_DIR=.

UPLOAD_DIR=data/uploads
CUTOUT_DIR=data/cutouts
OUTPUT_DIR=data/outputs
BACKGROUND_DIR=data/backgrounds
DEBUG_DIR=data/debug


# ===========================================
# 🧠 AI MODEL CONFIG
# ===========================================

# YOLO segmentation 모델
YOLO_MODEL_PATH=yolov8s-seg.pt

# CLIP 모델 이름
CLIP_MODEL_NAME=ViT-B/32

# Diffusion 모델 (inpainting용)
DIFFUSION_MODEL=stabilityai/stable-diffusion-2-inpainting

# 이미지-컴포지션 LLM (Gemma)
LLM_MODEL=google/gemma-2-2b-it


# ===========================================
# 🧪 DEBUG MODE (선택)
# ===========================================

# 디버그 이미지 출력(배경 safe zone, YOLO bbox, cutout 체크)
DEBUG=True

# 중간 산출물 저장 여부
SAVE_INTERMEDIATE=True
