# ===========================================
# 🔐 ENV / CONFIG (절대 업로드하면 안됨)
# ===========================================
.env
*.env

# 예시 템플릿은 포함
!.env.example


# ===========================================
# 📦 Python 일반 빌드/캐시 파일
# ===========================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.pickle

# Virtual environment
venv/
.venv/


# ===========================================
# 📝 VSCode 설정
# ===========================================
.vscode/
.code/


# ===========================================
# 📁 DATA FOLDERS (사용자 업로드, 중간 결과)
# ===========================================
# 업로드 이미지
data/uploads/
data/cutouts/
data/outputs/
data/debug/

# 배경은 템플릿으로 제공할 수도 있으니 제외하지 않음
# data/backgrounds/  ← 이건 보통 버전 관리함 (원본 배경 PNG들)


# ===========================================
# 🔍 DEBUG/LOG FILES
# ===========================================
*.log
*.tmp
*.DS_Store


# ===========================================
# 🤖 모델 관련 파일 (실수로 커밋 방지)
# ===========================================
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
*.bin

# HuggingFace 캐시
huggingface/
~huggingface/
~/.cache/huggingface
.cache/huggingface/


# ===========================================
# 🖼️ 이미지/영상 중간 생성물
# ===========================================
generated/
intermediate/
inference_output/
**/debug*/  
**/tmp/


# ===========================================
# 📦 Node 환경(프론트엔드)
# ===========================================
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
.next/
dist/
